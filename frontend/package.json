    "@tailwindcss/postcss": "^4.3.3",
    "next": "~16.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "daisyui": "^5.8.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
