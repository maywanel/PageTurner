# Public Nginx port. Backend and MySQL use private Compose networking.
HOST_PORT=8080
MYSQL_DATABASE=PageTurner_db
DATABASE_USERNAME=pageturner
DATABASE_PASSWORD=replace_with_a_random_password
MYSQL_ROOT_PASSWORD=replace_with_a_random_root_password
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
JWT_EXPIRATION=3600000
# make init replaces example secrets and preserves existing configuration.
# Compose constructs DATABASE_URL using db:3306; old local DATABASE_URL values are ignored.
# Optional first administrator (existing accounts are never overwritten):
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters
# Enable only with an already migrated schema and HTTPS at the gateway:
# SPRING_PROFILES_ACTIVE=prod
