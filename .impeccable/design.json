      "html": "<label class=\"ds-label\">Book title<input class=\"ds-field\" placeholder=\"Enter a title\"></label>",
      "css": ".ds-label{font:12px var(--sans,\"DM Sans Variable\",sans-serif);color:var(--ink,#28291f)}.ds-field{display:block;padding:11px 12px;margin-top:8px;background:#fbf9f2;border:1px solid #d9d5c8;border-radius:5px;font:14px var(--sans,\"DM Sans Variable\",sans-serif);color:var(--ink,#28291f)}.ds-field:focus-visible{outline:2px solid #75609b;outline-offset:4px}",
      "refersTo": "input"
