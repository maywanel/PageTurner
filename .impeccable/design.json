      "html": "<nav class=\"ds-views\" aria-label=\"View\"><button aria-pressed=\"true\">Shelf</button><button aria-pressed=\"false\">Covers</button><button aria-pressed=\"false\">Topics</button></nav>",
      "css": ".ds-views{display:inline-flex;gap:2px;border-radius:24px;padding:3px;background:#eae7df}.ds-views button{font-family:var(--sans,\"DM Sans Variable\",sans-serif);font-size:12px;cursor:pointer;transition:background .18s,color .18s,box-shadow .18s;border:0;padding:6px 13px;color:#6a695f;border-radius:20px;background:transparent}.ds-views button[aria-pressed=\"true\"]{background:#fffdf7;color:var(--ink,#28291f);box-shadow:0 2px 4px #342f2512}.ds-views button:hover{background:#fffdf7}.ds-views button:focus-visible{outline:2px solid #75609b;outline-offset:4px}"
